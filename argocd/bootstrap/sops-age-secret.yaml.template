# Template for the AGE private key secret used by the ksops CMP sidecar.
# DO NOT commit the actual age.agekey file or this file with real data.
#
# After generating your key (age-keygen -o age.agekey), create the secret:
#
#   kubectl create secret generic sops-age \
#     --namespace argocd \
#     --from-file=keys.agekey=age.agekey
#
# For GitHub Actions, store the private key as a repository secret named
# SOPS_AGE_PRIVATE_KEY and use it in the workflow to decrypt/encrypt.
#
# ------- DO NOT FILL IN AND COMMIT THIS FILE -------
apiVersion: v1
kind: Secret
metadata:
  name: sops-age
  namespace: argocd
type: Opaque
stringData:
  keys.agekey: |
    # created: <timestamp>
    # public key: age1ntkh6h060tngaw8k6jdvvj9hmaydf7zar4hzvpncfur78yqhd9psukzdv5
    AGE-SECRET-KEY-REPLACE_WITH_ACTUAL_PRIVATE_KEY
